{
  // Tell the generic YAML extension to use the CloudFormation schema
  // for SAM/CloudFormation template files — this silences the false-positive
  // "Unresolved tag: !Ref / !Sub / !GetAtt" errors.
  "yaml.customTags": [
    "!And scalar",
    "!And mapping",
    "!And sequence",
    "!If scalar",
    "!If mapping",
    "!If sequence",
    "!Not scalar",
    "!Not mapping",
    "!Not sequence",
    "!Equals scalar",
    "!Equals mapping",
    "!Equals sequence",
    "!Or scalar",
    "!Or mapping",
    "!Or sequence",
    "!FindInMap scalar",
    "!FindInMap mapping",
    "!FindInMap sequence",
    "!Base64 scalar",
    "!Base64 mapping",
    "!Base64 sequence",
    "!Cidr scalar",
    "!Cidr mapping",
    "!Cidr sequence",
    "!Ref scalar",
    "!Ref mapping",
    "!Ref sequence",
    "!Sub scalar",
    "!Sub mapping",
    "!Sub sequence",
    "!GetAtt scalar",
    "!GetAtt mapping",
    "!GetAtt sequence",
    "!GetAZs scalar",
    "!GetAZs mapping",
    "!GetAZs sequence",
    "!ImportValue scalar",
    "!ImportValue mapping",
    "!ImportValue sequence",
    "!Select scalar",
    "!Select mapping",
    "!Select sequence",
    "!Split scalar",
    "!Split mapping",
    "!Split sequence",
    "!Join scalar",
    "!Join mapping",
    "!Join sequence",
    "!Transform scalar",
    "!Transform mapping",
    "!Transform sequence",
    "!Condition scalar",
    "!Condition mapping",
    "!Condition sequence"
  ],
  // Disable the generic YAML schema validation on CloudFormation templates
  // (cfn-lint handles validation instead)
  "yaml.schemas": {
    "https://raw.githubusercontent.com/awslabs/goformation/master/schema/sam.schema.json": [
      "users/template.yaml",
      "**/template.yaml",
      "*.template.yaml"
    ]
  },
  // cfn-lint runs its own diagnostics — disable duplicate YAML validation
  "yaml.validate": false,
  // Point cfn-lint extension to the exact executable so it works regardless of PATH
  "cfnLint.path": "C:\\Users\\Admin\\AppData\\Local\\Programs\\Python\\Python312\\Scripts\\cfn-lint.exe",
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  }
}
